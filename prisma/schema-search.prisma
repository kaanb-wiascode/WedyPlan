datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum SearchDomain {
  GLOBAL
  VENDOR
  WEDDING
  CUSTOMER
  CONTRACT
  DOCUMENT
}

enum IndexStatus {
  PENDING
  INDEXED
  FAILED
}

model SearchHistory {
  id           String       @id @default(uuid())
  userId       String
  portalContext String
  queryText    String
  domain       SearchDomain @default(GLOBAL)
  resultCount  Int          @default(0)
  createdAt    DateTime     @default(now())

  @@index([userId, createdAt])
}

model SavedSearch {
  id           String       @id @default(uuid())
  userId       String
  title        String
  domain       SearchDomain
  filterParams Json         // Stored search payload and filters
  notifyOnMatch Boolean     @default(false)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([userId, domain])
}

model SearchAnalyticsLog {
  id           String       @id @default(uuid())
  queryText    String
  domain       SearchDomain
  executionMs  Int
  resultCount  Int
  clickedResultId String?
  userId       String?
  createdAt    DateTime     @default(now())

  @@index([queryText, domain])
  @@index([createdAt])
}

model SearchIndexQueue {
  id           String       @id @default(uuid())
  entityType   String       // e.g. "Vendor", "Contract", "Document"
  entityId     String
  operation    String       // "UPSERT" | "DELETE"
  status       IndexStatus  @default(PENDING)
  attemptCount Int          @default(0)
  errorMessage String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([status, createdAt])
}