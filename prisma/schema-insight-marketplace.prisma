// Insight Marketplace Asset Catalog
model InsightAsset {
  id              String   @id @default(cuid())
  title           String
  description     String
  assetType       String   // DASHBOARD, REPORT, KPI, METRIC, FORECAST, TEMPLATE
  category        String   // REVENUE, VENDORS, COUPLES, MARKETING, OPERATIONS
  author          String
  version         String   @default("1.0.0")
  rating          Float    @default(5.0)
  ratingCount     Int      @default(1)
  subscriberCount Int      @default(0)
  isFeatured      Boolean  @default(false)
  status          String   // PUBLISHED, DRAFT, ARCHIVED
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  subscriptions   InsightSubscription[]

  @@map("insight_assets")
}

// User Asset Subscriptions
model InsightSubscription {
  id          String       @id @default(cuid())
  assetId     String
  userId      String
  subscribedAt DateTime    @default(now())

  asset       InsightAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([assetId, userId])
  @@map("insight_subscriptions")
}