datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum PortalType {
  PUBLIC
  COUPLE
  VENDOR
  ADMIN
}

// PortalProfile is the bridge between the canonical IdentityUser account and
// application portals. Roles and permissions are owned by schema-access-control.prisma.
model PortalProfile {
  id           String     @id @default(uuid())
  userId       String
  portal       PortalType
  isPrimary    Boolean    @default(false)

  user         IdentityUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  roles        Role[]       @relation("ProfileRoles")

  createdAt    DateTime   @default(now())

  @@unique([userId, portal])
  @@index([userId])
}
