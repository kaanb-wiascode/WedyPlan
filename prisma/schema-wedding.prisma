enum BudgetItemStatus {
  PAID
  PENDING
  PARTIAL
}

enum ChecklistPriority {
  HIGH
  MEDIUM
  LOW
}

enum GuestRsvpStatus {
  PENDING
  ACCEPTED
  DECLINED
}

model Couple {
  id             String    @id @default(uuid())
  userId         String    @unique
  partnerOneName String
  partnerTwoName String?
  weddingDate    DateTime?
  targetBudget   Float     @default(350000)
  city           String?
  venueName      String    @default("")
  guestCountGoal Int       @default(0)
  vibe           String    @default("")
  slug           String?   @unique
  onboardingDone Boolean   @default(false)
  status         String    @default("ACTIVE")
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([userId])
  @@index([status])
}

model Vendor {
  id               String   @id @default(uuid())
  userId           String   @unique
  businessName     String
  businessCategory String   @default("OTHER")
  city             String?
  district         String?
  phone            String?
  website          String?
  description      String?
  status           String   @default("APPROVED")
  isVerified       Boolean  @default(false)
  services         String[] @default([])
  notes            String?
  companyType      String?
  kycStatus        String    @default("NOT_STARTED")
  activePackageCode String?
  slug             String?   @unique
  categorySlug     String?
  instagram        String?
  whatsapp         String?
  address          String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([businessCategory])
  @@index([categorySlug, city])
}

model BudgetItem {
  id              String            @id @default(uuid())
  userId          String
  title           String
  category        String
  allocatedAmount Float
  spentAmount     Float             @default(0)
  status          BudgetItemStatus  @default(PENDING)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([userId])
}

model Guest {
  id                 String          @id @default(uuid())
  userId             String
  fullName           String
  email              String?
  phone              String?
  group              String          @default("Ortak / Arkadaş")
  plusOneCount       Int             @default(0)
  rsvpStatus         GuestRsvpStatus @default(PENDING)
  dietaryPreference  String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@index([userId])
}

model ChecklistItem {
  id             String             @id @default(uuid())
  userId         String
  title          String
  category       String
  priority       ChecklistPriority  @default(MEDIUM)
  assignedToName String?
  dueDate        String?
  isCompleted    Boolean            @default(false)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([userId])
}
