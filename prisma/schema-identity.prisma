datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum PortalScope {
  PUBLIC
  COUPLE
  VENDOR
  ADMIN
}

enum UserAccountStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  LOCKED
  DELETED
}

model IdentityUser {
  id                  String            @id @default(uuid())
  email               String            @unique
  passwordHash        String?
  fullName            String
  phoneNumber         String?           @unique
  avatarUrl           String?
  status              UserAccountStatus @default(PENDING_VERIFICATION)
  isEmailVerified     Boolean           @default(false)
  emailVerifiedAt     DateTime?

  securityProfile     UserSecurityProfile?
  sessions            UserSession[]
  oauthAccounts       OAuthIdentity[]
  profiles            PortalProfile[]

  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@index([email])
  @@index([phoneNumber])
}

model UserSecurityProfile {
  id                   String       @id @default(uuid())
  userId               String       @unique
  failedLoginAttempts  Int          @default(0)
  lockedUntil          DateTime?
  lastPasswordChangeAt DateTime     @default(now())
  isTwoFactorEnabled   Boolean      @default(false)
  twoFactorSecret      String?

  user                 IdentityUser @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserSession {
  id                String       @id @default(uuid())
  userId            String
  tokenFamily       String
  refreshTokenHash  String       @unique
  ipAddress         String
  userAgent         String
  deviceFingerprint String?
  portalContext     PortalScope
  isRevoked         Boolean      @default(false)
  expiresAt         DateTime
  lastActiveAt      DateTime     @default(now())
  createdAt         DateTime     @default(now())

  user              IdentityUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRevoked])
  @@index([tokenFamily])
}

model OAuthIdentity {
  id                String       @id @default(uuid())
  userId            String
  provider          String
  providerAccountId String
  email             String
  metadata          Json?

  user              IdentityUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}
