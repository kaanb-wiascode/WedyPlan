// MLOps Datasets
model MlopsDataset {
  id          String   @id @default(cuid())
  name        String
  version     String
  type        String   // TRAINING, VALIDATION, TEST
  rowCount    Int
  featureCount Int
  qualityScore Float
  status      String   // READY, PROCESSING, ARCHIVED
  storagePath String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  models      MlopsModelDataset[]

  @@map("mlops_datasets")
}

// MLOps Inference Logs
model MlopsInferenceLog {
  id            String   @id @default(cuid())
  modelId       String
  modelVersion  String
  inputSummary  Json
  outputSummary Json
  latencyMs     Float
  driftScore    Float?
  flagged       Boolean  @default(false)
  timestamp     DateTime @default(now())

  @@index([modelId, timestamp])
  @@map("mlops_inference_logs")
}

// MLOps Model Drift & Retraining Triggers
model MlopsDriftMetric {
  id              String   @id @default(cuid())
  modelId         String
  featureName     String
  driftScore      Float
  threshold       Float
  status          String   // NORMAL, WARNING, CRITICAL
  retrainTriggered Boolean  @default(false)
  analyzedAt      DateTime @default(now())

  @@map("mlops_drift_metrics")
}

model MlopsModelDataset {
  modelId   String
  datasetId String
  dataset   MlopsDataset @relation(fields: [datasetId], references: [id], onDelete: Cascade)

  @@id([modelId, datasetId])
  @@map("mlops_model_datasets")
}