// --- Source: schema-media.prisma ---
enum MediaType {
  IMAGE
  VIDEO
  DOCUMENT
  AUDIO
  ARCHIVE
  ASSET_3D
}

enum StorageProvider {
  AMAZON_S3
  CLOUDFLARE_R2
  GOOGLE_CLOUD
  AZURE_BLOB
  LOCAL_DISK
}

enum VirusScanStatus {
  PENDING
  CLEAN
  INFECTED
  SKIPPED
}

enum AssetAccessLevel {
  PUBLIC
  PRIVATE
  RESTRICTED
}

model MediaFolder {
  id           String        @id @default(uuid())
  ownerId      String
  name         String
  slug         String
  parentId     String?
  
  parent       MediaFolder?  @relation("FolderHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  subfolders   MediaFolder[] @relation("FolderHierarchy")
  assets       MediaAsset[]

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([ownerId, slug, parentId])
  @@index([ownerId])
}

model MediaAsset {
  id               String           @id @default(uuid())
  ownerId          String
  folderId         String?
  type             MediaType
  originalFileName String
  fileExtension    String
  mimeType         String
  fileSizeBytes    BigInt
  fileHashSha256   String
  perceptualHash   String?
  accessLevel      AssetAccessLevel @default(PUBLIC)
  storageProvider  StorageProvider  @default(AMAZON_S3)
  storageBucket    String
  storageKey       String           @unique
  
  // CDN and Variant URLs
  cdnUrl           String
  avifUrl          String?
  webpUrl          String?
  thumbnailUrl     String?
  responsiveUrls   Json?            // { sm: string, md: string, lg: string, xl: string }
  
  // Metadata & Security
  width            Int?
  height           Int?
  durationSeconds  Float?
  scanStatus       VirusScanStatus  @default(PENDING)
  versionNumber    Int              @default(1)
  
  isDeleted        Boolean          @default(false)
  deletedAt        DateTime?

  folder           MediaFolder?     @relation(fields: [folderId], references: [id], onDelete: SetNull)
  versions         MediaVersion[]
  tags             MediaAssetTag[]

  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([ownerId, isDeleted])
  @@index([type, mimeType])
}

model MediaVersion {
  id           String     @id @default(uuid())
  assetId      String
  versionNumber Int
  storageKey   String
  cdnUrl       String
  fileSizeBytes BigInt
  createdById  String

  asset        MediaAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  createdAt    DateTime   @default(now())

  @@unique([assetId, versionNumber])
}

model MediaTag {
  id        String          @id @default(uuid())
  name      String          @unique
  assets    MediaAssetTag[]
}

model MediaAssetTag {
  assetId   String
  tagId     String

  asset     MediaAsset      @relation(fields: [assetId], references: [id], onDelete: Cascade)
  tag       MediaTag        @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([assetId, tagId])
}

model StorageQuota {
  id               String   @id @default(uuid())
  ownerId          String   @unique
  allocatedBytes   BigInt   // e.g. 5GB = 5368709120 Bytes
  usedBytes        BigInt   @default(0)
  fileCount        Int      @default(0)
  updatedAt        DateTime @updatedAt

  @@index([ownerId])
}

// --- Source: schema-messaging.prisma ---
enum ConversationType {
  COUPLE_VENDOR
  VENDOR_STAFF
  VENDOR_ADMIN
  CUSTOMER_SUPPORT
  AI_USER
}

enum ParticipantRole {
  OWNER
  MEMBER
  SUPPORT_AGENT
  SYSTEM_BOT
}

enum MessageType {
  TEXT
  IMAGE
  DOCUMENT
  VOICE_NOTE
  SYSTEM_ALERT
}

enum MessageDeliveryStatus {
  SENT
  DELIVERED
  READ
  FAILED
}

model Conversation {
  id               String                    @id @default(uuid())
  type             ConversationType
  title            String?
  relatedEntityId  String?                   // Offer ID, Booking ID, or Support Ticket ID
  isArchived       Boolean                   @default(false)
  isPinned         Boolean                   @default(false)
  lastMessageAt    DateTime                  @default(now())
  
  participants     ConversationParticipant[]
  messages         Message[]

  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt

  @@index([type, isArchived])
  @@index([lastMessageAt])
}

model ConversationParticipant {
  id             String          @id @default(uuid())
  conversationId String
  userId         String
  role           ParticipantRole @default(MEMBER)
  unreadCount    Int             @default(0)
  lastReadAt     DateTime?
  isMuted        Boolean         @default(false)

  conversation   Conversation    @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String                @id @default(uuid())
  conversationId String
  senderUserId   String
  type           MessageType           @default(TEXT)
  bodyText       String
  deliveryStatus MessageDeliveryStatus @default(SENT)
  isSpamFlagged  Boolean               @default(false)
  
  attachments    MessageAttachment[]
  reactions      MessageReaction[]

  conversation   Conversation          @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@index([conversationId, createdAt])
  @@index([senderUserId])
}

model MessageAttachment {
  id           String      @id @default(uuid())
  messageId    String
  mediaAssetId String      // Reference to Enterprise Media Asset
  fileUrl      String
  fileName     String
  fileSizeBytes Int
  mimeType     String

  message      Message     @relation(fields: [messageId], references: [id], onDelete: Cascade)
}

model MessageReaction {
  id        String   @id @default(uuid())
  messageId String
  userId    String
  emoji     String   // e.g. "👍", "❤️", "🎉"

  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
}

model SpamFlagLog {
  id          String   @id @default(uuid())
  messageId   String
  senderUserId String
  reason      String
  flaggedText String
  createdAt   DateTime @default(now())

  @@index([senderUserId])
}

// --- Source: schema-notifications.prisma ---
enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
  WHATSAPP
  PUSH
  BROWSER
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum NotificationCategory {
  TRANSACTIONAL
  MARKETING
  SYSTEM
  WEDDING_REMINDER
  CRM_LEAD
  SECURITY
}

enum DeliveryStatus {
  PENDING
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
}

model NotificationTemplate {
  id          String              @id @default(uuid())
  code        String              @unique // e.g. "OFFER_RECEIVED_COUPLE"
  category    NotificationCategory
  channel     NotificationChannel
  subject     String?             // For Email / Push titles
  bodyTemplate String             // Template with placeholders {{coupleName}}, {{vendorName}}
  isActive    Boolean             @default(true)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([code, channel])
}

model NotificationPreference {
  id          String              @id @default(uuid())
  userId      String
  category    NotificationCategory
  channel     NotificationChannel
  isEnabled   Boolean             @default(true)
  updatedAt   DateTime            @updatedAt

  @@unique([userId, category, channel])
  @@index([userId])
}

model InAppNotification {
  id          String               @id @default(uuid())
  userId      String
  title       String
  message     String
  category    NotificationCategory
  priority    NotificationPriority @default(NORMAL)
  actionUrl   String?
  isRead      Boolean              @default(false)
  readAt      DateTime?
  metadata    Json?
  createdAt   DateTime             @default(now())

  @@index([userId, isRead])
}

model NotificationLog {
  id             String              @id @default(uuid())
  userId         String
  templateCode   String
  channel        NotificationChannel
  priority       NotificationPriority
  recipientTarget String             // Email, Phone, Device Token
  status         DeliveryStatus      @default(PENDING)
  attemptCount   Int                 @default(0)
  errorMessage   String?
  deliveredAt    DateTime?
  readAt         DateTime?
  metadata       Json?
  createdAt      DateTime            @default(now())

  @@index([userId, status])
  @@index([createdAt])
}

// --- Source: schema-payment.prisma ---
enum PaymentProvider {
  IYZICO
  PAYTR
  STRIPE
  PAYPAL
  APPLE_PAY
  GOOGLE_PAY
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  SUCCESS
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
  DISPUTED
}

enum PaymentType {
  SUBSCRIPTION
  MARKETPLACE_BOOKING
  LEAD_PURCHASE
  FEATURED_LISTING
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  UNPAID
  TRIALING
}

enum Currency {
  TRY
  USD
  EUR
  GBP
}

model PaymentTransaction {
  id                    String            @id @default(uuid())
  userId                String
  organizationId        String?
  type                  PaymentType
  provider              PaymentProvider
  providerTransactionId String?           @unique
  idempotencyKey        String            @unique
  
  // Amounts in Decimals (TRY/USD)
  grossAmount           Decimal           @db.Decimal(12, 2)
  platformCommission    Decimal           @db.Decimal(12, 2) @default(0.00)
  vendorNetAmount       Decimal           @db.Decimal(12, 2) @default(0.00)
  taxAmount             Decimal           @db.Decimal(12, 2) @default(0.00)
  currency              Currency          @default(TRY)
  
  status                PaymentStatus     @default(PENDING)
  failureReason         String?
  metadata              Json?
  
  invoice               Invoice?

  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  @@index([userId, status])
  @@index([provider, providerTransactionId])
  @@index([createdAt])
}

model SubscriptionPlan {
  id            String             @id @default(uuid())
  code          String             @unique // e.g. "VENDOR_PRO_MONTHLY", "COUPLE_PREMIUM"
  name          String
  price         Decimal            @db.Decimal(12, 2)
  currency      Currency           @default(TRY)
  billingCycle  String             // "MONTHLY" | "YEARLY"
  featuresJson  Json?
  isActive      Boolean            @default(true)
  
  subscriptions UserSubscription[]

  createdAt     DateTime           @default(now())
}

model UserSubscription {
  id                   String             @id @default(uuid())
  userId               String
  planId               String
  provider             PaymentProvider
  providerSubId        String?            @unique
  cardToken            String?
  status               SubscriptionStatus @default(ACTIVE)
  currentPeriodStart   DateTime
  currentPeriodEnd     DateTime
  cancelAtPeriodEnd    Boolean            @default(false)
  failedRetryCount     Int                @default(0)

  plan                 SubscriptionPlan   @relation(fields: [planId], references: [id])

  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([userId, status])
}

model Invoice {
  id               String             @id @default(uuid())
  transactionId    String             @unique
  invoiceNumber    String             @unique // e.g. "WED2026-0001042"
  userId           String
  taxNumber        String?
  taxOffice        String?
  billingAddress   String
  subTotal         Decimal            @db.Decimal(12, 2)
  taxTotal         Decimal            @db.Decimal(12, 2)
  grandTotal       Decimal            @db.Decimal(12, 2)
  pdfUrl           String?
  
  transaction      PaymentTransaction @relation(fields: [transactionId], references: [id])
  items            InvoiceItem[]

  createdAt        DateTime           @default(now())
}

model InvoiceItem {
  id          String   @id @default(uuid())
  invoiceId   String
  description String
  quantity    Int      @default(1)
  unitPrice   Decimal  @db.Decimal(12, 2)
  taxRatePercent Int   @default(20)
  totalAmount Decimal  @db.Decimal(12, 2)

  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model CommissionRule {
  id                  String   @id @default(uuid())
  vendorCategoryCode  String   @unique // e.g. "VENUE", "PHOTOGRAPHY"
  commissionRatePercent Decimal @db.Decimal(5, 2) // e.g. 10.00 = %10
  updatedAt           DateTime @updatedAt
}

model Coupon {
  id               String    @id @default(uuid())
  code             String    @unique // e.g. "WEDY2026"
  discountPercent  Decimal?  @db.Decimal(5, 2)
  discountAmount   Decimal?  @db.Decimal(12, 2)
  maxUses          Int       @default(100)
  currentUses      Int       @default(0)
  expiresAt        DateTime?
  isActive         Boolean   @default(true)
}

model WebhookLog {
  id            String          @id @default(uuid())
  provider      PaymentProvider
  eventId       String          @unique
  eventType     String
  payloadJson   Json
  isProcessed   Boolean         @default(false)
  processedAt   DateTime?

  createdAt     DateTime        @default(now())

  @@index([provider, eventId])
}

// --- Source: schema-search.prisma ---
enum SearchDomainSource {
  VENDOR
  COUPLE
  USER
  ORGANIZATION
  CONTRACT
  PAYMENT
  DOCUMENT
  CAMPAIGN
  MESSAGE
  SUPPORT_TICKET
  REVIEW
  CATEGORY
  ARTICLE
  FAQ
  AI_KNOWLEDGE_BASE
}

enum IndexSyncStatus {
  PENDING
  INDEXED
  FAILED
  STALE
}

model SearchIndexRegistry {
  id               String             @id @default(uuid())
  entityType       SearchDomainSource
  entityId         String
  documentTitle    String
  documentContent  String
  keywords         String[]
  vectorEmbedding  Float[]            // OpenAI text-embedding-3 1536 dimension
  syncStatus       IndexSyncStatus    @default(PENDING)
  popularityScore  Float              @default(1.0)
  organizationId   String?
  ownerUserId      String?
  isPublic         Boolean            @default(true)
  metadata         Json?
  
  indexedAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@unique([entityType, entityId])
  @@index([entityType, isPublic])
  @@index([syncStatus])
}

model SearchSynonym {
  id               String             @id @default(uuid())
  term             String             @unique // e.g. "kır bahçesi"
  synonyms         String[]           // ["açık hava mekanı", "botanik bahçe", "kır düğünü"]
  isBiDirectional  Boolean            @default(true)
  createdAt        DateTime           @default(now())
}

model TrendingSearchTopic {
  id               String             @id @default(uuid())
  keyword          String             @unique
  searchCount      Int                @default(1)
  category         SearchDomainSource @default(VENDOR)
  isPromoted       Boolean            @default(false)
  updatedAt        DateTime           @updatedAt

  @@index([searchCount, isPromoted])
}

model SearchHistory {
  id               String             @id @default(uuid())
  userId           String
  portalContext    String
  queryText        String
  domainSource     SearchDomainSource @default(VENDOR)
  resultCount      Int                @default(0)
  createdAt        DateTime           @default(now())

  @@index([userId, createdAt])
}

model SavedSearchQuery {
  id               String             @id @default(uuid())
  userId           String
  title            String
  queryText        String
  filtersJson      Json?
  notifyOnMatches  Boolean            @default(false)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([userId])
}

model SearchAnalyticsLog {
  id               String             @id @default(uuid())
  queryText        String
  domainSource     SearchDomainSource
  executionMs      Int
  resultCount      Int
  clickedEntityId  String?
  userId           String?
  createdAt        DateTime           @default(now())

  @@index([queryText, domainSource])
  @@index([createdAt])
}

// --- Source: schema-universal-notifications.prisma ---
// [Atlandı - Çift Tanım] enum NotificationChannel

// [Atlandı - Çift Tanım] enum NotificationCategory

// [Atlandı - Çift Tanım] enum NotificationPriority

enum NotificationStatus {
  UNSEEN
  SEEN
  READ
  DISMISSED
  ARCHIVED
}

enum JobDeliveryState {
  QUEUED
  PROCESSING
  SENT
  FAILED
  SCHEDULED
  DEFERRED_QUIET_HOURS
}

model UniversalNotification {
  id              String               @id @default(uuid())
  userId          String
  category        NotificationCategory
  priority        NotificationPriority @default(NORMAL)
  title           String
  body            String
  actionUrl       String?
  imageUrl        String?
  status          NotificationStatus   @default(UNSEEN)
  seenAt          DateTime?
  readAt          DateTime?
  dismissedAt     DateTime?
  archivedAt      DateTime?
  batchGroupId    String?
  metadata        Json?
  
  deliveryLogs    NotificationDeliveryLog[]

  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([userId, status])
  @@index([category, priority])
  @@index([createdAt])
}

model NotificationTemplateI18n {
  id              String               @id @default(uuid())
  code            String               // e.g. "OFFER_RECEIVED", "PAYMENT_REMINDER"
  locale          String               // "tr", "en", "de"
  category        NotificationCategory
  subjectTemplate String?
  bodyTemplate    String
  actionUrlTemplate String?

  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@unique([code, locale])
  @@index([code])
}

model NotificationChannelPreference {
  id               String               @id @default(uuid())
  userId           String
  category         NotificationCategory
  channel          NotificationChannel
  isEnabled        Boolean              @default(true)
  quietHoursStart  String?              // "22:00"
  quietHoursEnd    String?              // "08:00"
  timezone         String               @default("Europe/Istanbul")

  updatedAt        DateTime             @updatedAt

  @@unique([userId, category, channel])
  @@index([userId])
}

model NotificationQueueJob {
  id              String               @id @default(uuid())
  userId          String
  channel         NotificationChannel
  category        NotificationCategory
  priority        NotificationPriority
  state           JobDeliveryState     @default(QUEUED)
  payloadJson     Json
  scheduledFor    DateTime             @default(now())
  attemptCount    Int                  @default(0)
  maxRetries      Int                  @default(3)
  lastErrorMessage String?
  
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([state, scheduledFor])
  @@index([userId])
}

model NotificationDeliveryLog {
  id               String               @id @default(uuid())
  notificationId   String?
  userId           String
  channel          NotificationChannel
  externalMessageId String?
  deliveryState    JobDeliveryState
  executionMs      Int
  errorMessage     String?
  
  notification     UniversalNotification? @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  createdAt        DateTime             @default(now())

  @@index([userId, channel])
  @@index([createdAt])
}
