datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}


// --- Source: schema-access-control.prisma ---
enum AccessScope {
  SYSTEM
  ORGANIZATION
  PORTAL
  MODULE
  ROUTE
  API
  UI
  FIELD
}

enum AccessAction {
  VIEW
  CREATE
  UPDATE
  DELETE
  APPROVE
  REJECT
  EXPORT
  IMPORT
  ASSIGN
  TRANSFER
  ARCHIVE
  RESTORE
  MANAGE
}

enum SubscriptionTier {
  FREE
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

model PermissionGroup {
  id          String       @id @default(uuid())
  code        String       @unique // e.g. "BUDGET_MODULE", "CRM_LEADS"
  name        String
  description String?
  permissions Permission[]
  createdAt   DateTime     @default(now())
}

model Permission {
  id              String            @id @default(uuid())
  code            String            @unique // e.g. "wedding:budget:update", "vendor:contract:approve"
  groupId         String?
  scope           AccessScope
  action          AccessAction
  resource        String            // e.g. "budget_item", "lead", "contract"
  description     String?
  isCustom        Boolean           @default(false)
  
  group           PermissionGroup?  @relation(fields: [groupId], references: [id], onDelete: SetNull)
  roles           RolePermission[]
  directUsers     UserDirectPermission[]
  tierPermissions SubscriptionTierPermission[]

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([scope, action, resource])
}

model Role {
  profiles PortalProfile[] @relation("ProfileRoles")
  id          String            @id @default(uuid())
  code        String            @unique // e.g. "VENDOR_OWNER", "SUPPORT", "COUPLE"
  name        String
  description String?
  isSystem    Boolean           @default(false)
  
  // Role Hierarchy (Parent - Child Relationships)
  parents     RoleInheritance[] @relation("ChildRoles")
  children    RoleInheritance[] @relation("ParentRoles")
  
  permissions RolePermission[]
  
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

model RoleInheritance {
  parentId    String
  childId     String

  parent      Role     @relation("ParentRoles", fields: [parentId], references: [id], onDelete: Cascade)
  child       Role     @relation("ChildRoles", fields: [childId], references: [id], onDelete: Cascade)

  @@id([parentId, childId])
}

model RolePermission {
  roleId       String
  permissionId String

  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserDirectPermission {
  id           String     @id @default(uuid())
  userId       String
  permissionId String
  isGranted    Boolean    @default(true) // true = grant, false = explicit deny
  expiresAt    DateTime?  // Temporary permission expiration
  reason       String?

  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  createdAt    DateTime   @default(now())

  @@index([userId, expiresAt])
}

model SubscriptionTierPermission {
  id           String           @id @default(uuid())
  tier         SubscriptionTier
  permissionId String

  permission   Permission       @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([tier, permissionId])
}

model FeatureFlag {
  id          String   @id @default(uuid())
  key         String   @unique // e.g. "ai_budget_optimizer_v2", "whatsapp_auto_reply"
  name        String
  isEnabled   Boolean  @default(false)
  rulesJson   Json?    // Targeting rules (e.g. specific organization IDs or percentages)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AccessAuditLog {
  id             String       @id @default(uuid())
  userId         String?
  action         AccessAction
  resource       String
  permissionCode String?
  isAllowed      Boolean
  portalContext  String?
  organizationId String?
  reason         String?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime     @default(now())

  @@index([userId, isAllowed])
  @@index([createdAt])
}

// --- Source: schema-ai.prisma ---
// Predictive Analytics Forecast Models & Results
model PredictiveForecast {
  id               String   @id @default(cuid())
  metricType       String   // REVENUE, BOOKINGS, MARKETPLACE_GROWTH, RETENTION, VENDOR_GROWTH, CASH_FLOW
  timeframe        String   // MONTHLY, QUARTERLY, ANNUAL
  forecastValue    Float
  lowerBound       Float    // Confidence Interval Low
  upperBound       Float    // Confidence Interval High
  confidenceScore  Float    // e.g., 0.95 (95%)
  trendDirection   String   // UPWARD, STABLE, DOWNWARD
  riskScore        Float    // 0 - 1.0 Risk index
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  simulations      PredictiveSimulation[]

  @@map("predictive_forecasts")
}

model PredictiveSimulation {
  id              String             @id @default(cuid())
  forecastId      String
  scenarioName    String             // BULL_CASE, BASE_CASE, BEAR_CASE, CUSTOM
  growthModifier  Float              // Percentage multiplier (e.g. +15%, -10%)
  simulatedValue  Float
  riskLevel       String             // LOW, MEDIUM, HIGH
  forecast        PredictiveForecast @relation(fields: [forecastId], references: [id], onDelete: Cascade)
  createdAt       DateTime           @default(now())

  @@map("predictive_simulations")
}

// --- Source: schema-audit.prisma ---
enum AuditActionCategory {
  AUTHENTICATION
  PERMISSION_CHANGE
  PAYMENT
  CONTRACT
  SUBSCRIPTION
  VENDOR_UPDATE
  CUSTOMER_UPDATE
  AI_REQUEST
  MESSAGING
  DOCUMENT
  CAMPAIGN
  SUPPORT_TICKET
  SYSTEM_ERROR
  API_REQUEST
}

enum AuditSeverity {
  INFO
  WARNING
  ERROR
  CRITICAL
}

model AuditLog {
  id               String              @id @default(uuid())
  correlationId    String
  category         AuditActionCategory
  action           String              // e.g. "CONTRACT_SIGNED", "USER_LOGIN_FAILED"
  severity         AuditSeverity       @default(INFO)
  
  // Actor Info
  actorUserId      String?
  actorRole        String?
  actorIpAddress   String?
  actorUserAgent   String?
  
  // Target Entity Info
  targetEntity     String?             // e.g. "Contract", "PaymentTransaction"
  targetEntityId   String?             
  
  // State Diff
  beforeStateJson  Json?
  afterStateJson   Json?
  diffJson         Json?
  
  metadata         Json?

  createdAt        DateTime            @default(now())

  @@index([category, createdAt])
  @@index([actorUserId, createdAt])
  @@index([targetEntity, targetEntityId])
}

model UserActivityLog {
  id               String              @id @default(uuid())
  userId           String
  portalContext    String
  action           String              // e.g. "VIEWED_OFFER", "SAVED_VENDOR"
  summary          String
  targetEntityId   String?
  ipAddress        String?
  
  createdAt        DateTime            @default(now())

  @@index([userId, portalContext, createdAt])
}

model SystemPerformanceMetric {
  id               String   @id @default(uuid())
  correlationId    String?
  endpointPath     String
  httpMethod       String
  statusCode       Int
  executionMs      Int
  dbQueryTimeMs    Int?
  memoryUsageMb    Float?
  
  createdAt        DateTime @default(now())

  @@index([endpointPath, createdAt])
  @@index([executionMs])
}

model AuditRetentionPolicy {
  id               String              @id @default(uuid())
  category         AuditActionCategory @unique
  retentionDays    Int                 @default(365)
  autoArchive      Boolean             @default(true)
  
  updatedAt        DateTime            @updatedAt
}

// --- Source: schema-auth.prisma ---
enum PortalType {
  PUBLIC
  COUPLE
  VENDOR
  ADMIN
}

enum GlobalUserStatus {
  ACTIVE
  SUSPENDED
  PENDING_VERIFICATION
}

model User {
  id                String           @id @default(uuid())
  email             String           @unique
  passwordHash      String?
  fullName          String
  phone             String?          @unique
  avatarUrl         String?
  status            GlobalUserStatus @default(PENDING_VERIFICATION)
  isEmailVerified   Boolean          @default(false)
  isTwoFactorActive Boolean          @default(false)
  twoFactorSecret   String?
  
  // Relations
  profiles          PortalProfile[]
  sessions          Session[]
  oauthAccounts     OAuthAccount[]
  
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([email])
}

model PortalProfile {
  id           String     @id @default(uuid())
  userId       String
  portal       PortalType
  isPrimary    Boolean    @default(false)
  
  // Granular Role & Membership Context
  roles        Role[]     @relation("ProfileRoles")
  
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([userId, portal])
}

// [Atlandı - Çift Tanım] model Role

// [Atlandı - Çift Tanım] model Permission

model Session {
  id             String    @id @default(uuid())
  userId         String
  portalContext  PortalType
  refreshTokenHash String  @unique
  ipAddress      String
  userAgent      String
  deviceOs       String?
  browser        String?
  isRevoked      Boolean   @default(false)
  expiresAt      DateTime
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, portalContext])
}

model OAuthAccount {
  id                String   @id @default(uuid())
  userId            String
  provider          String   // "google" | "apple"
  providerAccountId String
  accessToken       String?
  refreshToken      String?
  expiresAt         Int?
  
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

// --- Source: schema-calendar.prisma ---
enum CalendarOwnerType {
  COUPLE
  VENDOR
  ADMIN
  SYSTEM
}

enum EventCategory {
  WEDDING_DAY
  MEETING
  TASTING_SESSION
  PROVA
  INSTALLATION
  PAYMENT_DUE
  PERSONAL_BLOCKED
}

enum EventStatus {
  CONFIRMED
  TENTATIVE
  CANCELLED
}

enum RecurrenceFrequency {
  NONE
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum GuestRsvpStatus {
  PENDING
  ACCEPTED
  DECLINED
}

model CalendarEvent {
  id                   String               @id @default(uuid())
  ownerId              String
  ownerType            CalendarOwnerType
  category             EventCategory
  status               EventStatus          @default(CONFIRMED)
  title                String
  description          String?
  location             String?
  timezone             String               @default("Europe/Istanbul")
  
  // Time Parameters (ISO UTC)
  startTime            DateTime
  endTime              DateTime
  isAllDay             Boolean              @default(false)
  
  // Travel & Setup Buffer Times (in Minutes)
  travelBufferBeforeMin Int                  @default(0)
  travelBufferAfterMin  Int                  @default(0)
  
  // Recurrence
  recurrenceFreq       RecurrenceFrequency  @default(NONE)
  recurrenceUntil      DateTime?
  
  // Metadata
  relatedEntityId      String?              // Offer ID, Contract ID, or Booking ID
  isPrivate            Boolean              @default(false)

  guests               CalendarEventGuest[]

  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  @@index([ownerId, ownerType])
  @@index([startTime, endTime])
  @@index([status])
}

model CalendarWorkingHours {
  id               String            @id @default(uuid())
  ownerId          String
  dayOfWeek        Int               // 0 = Sunday, 1 = Monday ... 6 = Saturday
  startTimeStr     String            // "09:00"
  endTimeStr       String            // "18:00"
  slotDurationMin  Int               @default(60)
  isWorkingDay     Boolean           @default(true)

  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@unique([ownerId, dayOfWeek])
}

model CalendarBlockedDate {
  id          String            @id @default(uuid())
  ownerId     String
  ownerType   CalendarOwnerType
  startDate   DateTime
  endDate     DateTime
  reason      String?

  createdAt   DateTime          @default(now())

  @@index([ownerId, startDate, endDate])
}

model CalendarEventGuest {
  id          String            @id @default(uuid())
  eventId     String
  email       String
  fullName    String?
  rsvpStatus  GuestRsvpStatus   @default(PENDING)

  event       CalendarEvent     @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, email])
}

model ExternalCalendarSync {
  id                 String            @id @default(uuid())
  ownerId            String
  provider           String            // "GOOGLE", "APPLE", "OUTLOOK"
  externalCalendarId String
  accessToken        String
  refreshToken       String?
  lastSyncedAt       DateTime?

  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@unique([ownerId, provider])
}

// --- Source: schema-data-command-center.prisma ---
// Executive Data Command Center Metrics
model ExecutiveDataMetrics {
  id                    String   @id @default(cuid())
  roleView              String   // CEO, CTO, CIO, CDO, CFO, AI_DIRECTOR
  enterpriseHealthScore Float    // 0 - 100
  activeRiskIndex       Float    // 0 - 100
  subsystemStatus       Json     // Status map of Data Lake, Streaming, Quality, Feature Store, etc.
  strategicInsights     Json     // Array of Strategic Insights
  optimizationRecs     Json     // Array of Optimization Recommendations
  updatedAt             DateTime @updatedAt

  @@map("executive_data_metrics")
}

// --- Source: schema-data-sharing.prisma ---
// Data Sharing Shares & Policies
model DataSharePolicy {
  id              String   @id @default(cuid())
  name            String
  targetType      String   // INTERNAL_ROLE, PARTNER_VENDOR, EXTERNAL_API
  targetIdentifier String  // e.g. "ROLE_VENDOR_VIP", "PARTNER_HUB_01"
  dataScope       String   // e.g. "ANALYTICS_READ_ONLY", "TRANSACTIONS_PARTIAL"
  sensitivityLevel String  // PUBLIC, INTERNAL, SENSITIVE, CRITICAL
  status          String   // ACTIVE, SUSPENDED, EXPIRED
  hasDataContract Boolean  @default(true)
  expiresAt       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  auditLogs       DataShareAuditLog[]

  @@map("data_share_policies")
}

// Data Share Usage Audit Logs
model DataShareAuditLog {
  id              String          @id @default(cuid())
  policyId        String
  accessorId      String
  actionType      String          // EXPORT_CSV, API_QUERY, CONTRACT_VALIDATION
  recordsAccessed Int
  riskScore       Float
  sensitiveDataFlag Boolean       @default(false)
  ipAddress       String
  timestamp       DateTime        @default(now())

  policy          DataSharePolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@index([policyId, timestamp])
  @@map("data_share_audit_logs")
}

// --- Source: schema-identity.prisma ---
enum PortalScope {
  PUBLIC
  COUPLE
  VENDOR
  ADMIN
}

enum UserAccountStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  LOCKED
  DELETED
}

enum AuditActionType {
  LOGIN_SUCCESS
  LOGIN_FAILED
  TOKEN_REFRESHED
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_COMPLETED
  EMAIL_VERIFIED
  ROLE_GRANTED
  SESSION_REVOKED
  SECURITY_ALERT
}

model IdentityUser {
  id                  String            @id @default(uuid())
  email               String            @unique
  passwordHash        String?           // Argon2id Hash
  fullName            String
  phoneNumber         String?           @unique
  avatarUrl           String?
  status              UserAccountStatus @default(PENDING_VERIFICATION)
  isEmailVerified     Boolean           @default(false)
  emailVerifiedAt     DateTime?
  
  // Relations
  securityProfile     UserSecurityProfile?
  roles               UserRoleAssignment[]
  sessions            UserSession[]
  oauthAccounts       OAuthIdentity[]

  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@index([email])
  @@index([phoneNumber])
}

model UserSecurityProfile {
  id                   String       @id @default(uuid())
  userId               String       @unique
  failedLoginAttempts  Int          @default(0)
  lockedUntil          DateTime?
  lastPasswordChangeAt DateTime     @default(now())
  isTwoFactorEnabled   Boolean      @default(false)
  twoFactorSecret      String?
  
  user                 IdentityUser @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model IdentityRole {
  id          String               @id @default(uuid())
  code        String               @unique // e.g., "SUPER_ADMIN", "VENDOR_MANAGER", "COUPLE"
  name        String
  description String?
  isSystem    Boolean              @default(false)
  portal      PortalScope
  
  permissions RolePermissionMap[]
  users       UserRoleAssignment[]

  createdAt   DateTime             @default(now())
}

model IdentityPermission {
  id          String              @id @default(uuid())
  code        String              @unique // e.g., "wedding:budget:write", "vendor:leads:read"
  category    String
  description String?
  
  roles       RolePermissionMap[]

  createdAt   DateTime            @default(now())
}

model RolePermissionMap {
  roleId       String
  permissionId String

  role         IdentityRole       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   IdentityPermission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserRoleAssignment {
  userId     String
  roleId     String
  portal     PortalScope

  user       IdentityUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       IdentityRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId, portal])
}

model UserSession {
  id                String       @id @default(uuid())
  userId            String
  tokenFamily       String       // Grouping ID for rotation tracking
  refreshTokenHash  String       @unique
  ipAddress         String
  userAgent         String
  deviceFingerprint String?
  portalContext     PortalScope
  isRevoked         Boolean      @default(false)
  expiresAt         DateTime
  lastActiveAt      DateTime     @default(now())
  createdAt         DateTime     @default(now())

  user              IdentityUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRevoked])
  @@index([tokenFamily])
}

model OAuthIdentity {
  id                String       @id @default(uuid())
  userId            String
  provider          String       // "google", "apple", "microsoft"
  providerAccountId String
  email             String
  metadata          Json?

  user              IdentityUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

